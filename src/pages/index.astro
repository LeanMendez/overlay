---
import '../styles/global.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Stream Overlays</title>
		<style>
			body {
				background: #0a0a0a;
				min-height: 100vh;
				display: flex;
				justify-content: center;
				align-items: center;
				padding: 2rem;
			}
			.overlay-link {
				display: block;
				padding: 1.5rem 2rem;
				background: rgba(255, 255, 255, 0.05);
				border: 2px solid rgba(255, 255, 255, 0.2);
				color: white;
				text-decoration: none;
				transition: all 0.3s ease;
				font-size: 1.25rem;
				font-weight: 300;
			}
			.overlay-link:hover {
				background: rgba(255, 255, 255, 0.1);
				border-color: rgba(255, 255, 255, 0.5);
				transform: translateX(8px);
			}
		</style>
	</head>
	<body>
		<div class="max-w-2xl w-full">
			<h1 class="text-white text-4xl font-light mb-8 text-center">Stream Overlays</h1>
			<p class="text-white/60 text-center mb-8">Overlays minimalistas con estética futurista para tu stream</p>
			<div class="flex flex-col gap-4">
				<a href="/camera-frame" class="overlay-link">
					<div class="flex items-center justify-between">
						<span>Camera Frame</span>
						<span class="text-sm text-white/50">5 variantes</span>
					</div>
				</a>
				<a href="/alert-box" class="overlay-link">
					<div class="flex items-center justify-between">
						<span>Alert Box</span>
						<span class="text-sm text-white/50">5 tipos de alertas</span>
					</div>
				</a>
				<a href="/stream-screens" class="overlay-link">
					<div class="flex items-center justify-between">
						<span>Stream Screens</span>
						<span class="text-sm text-white/50">Starting, BRB & Ending</span>
					</div>
				</a>
				<a href="/chat-overlay" class="overlay-link">
					<div class="flex items-center justify-between">
						<span>Chat Overlay</span>
						<span class="text-sm text-white/50">Glassmorphism</span>
					</div>
				</a>
				<a href="/goal-tracker" class="overlay-link">
					<div class="flex items-center justify-between">
						<span>Goal Tracker</span>
						<span class="text-sm text-white/50">Progress & Celebration</span>
					</div>
				</a>
				<a href="/goal-tracker-compact" class="overlay-link">
					<div class="flex items-center justify-between">
						<span>Goal Tracker Compact</span>
						<span class="text-sm text-white/50">Para gameplay</span>
					</div>
				</a>
			</div>

			<div class="mt-8 pt-8 border-t border-white/20">
				<h2 class="text-white text-2xl font-light mb-4 text-center">Mint Pixel Art CRT</h2>
				<p class="text-white/40 text-sm text-center mb-4">Dirección oscura terminal/CRT — reemplaza el mint pastel anterior</p>
				<div class="flex flex-col gap-3 mb-8">
					<a href="/screens/mint/waiting-alba" class="overlay-link" style="background: rgba(79, 211, 171, 0.08); border-color: rgba(79, 211, 171, 0.3);">
						<div class="flex items-center justify-between">
							<span>Ya Comenzamos · Alba</span>
							<span class="text-sm text-white/50">1a</span>
						</div>
					</a>
					<a href="/screens/mint/waiting-consola" class="overlay-link" style="background: rgba(79, 211, 171, 0.08); border-color: rgba(79, 211, 171, 0.3);">
						<div class="flex items-center justify-between">
							<span>Ya Comenzamos · Consola</span>
							<span class="text-sm text-white/50">1c</span>
						</div>
					</a>
					<a href="/screens/mint/ingame-riel" class="overlay-link" style="background: rgba(79, 211, 171, 0.08); border-color: rgba(79, 211, 171, 0.3);">
						<div class="flex items-center justify-between">
							<span>Overlay En Juego · Riel Derecho</span>
							<span class="text-sm text-white/50">1d</span>
						</div>
					</a>
					<a href="/screens/mint/ingame-fps" class="overlay-link" style="background: rgba(79, 211, 171, 0.08); border-color: rgba(79, 211, 171, 0.3);">
						<div class="flex items-center justify-between">
							<span>Overlay En Juego · FPS</span>
							<span class="text-sm text-white/50">1f</span>
						</div>
					</a>
					<a href="/screens/mint/clean-bg" class="overlay-link" style="background: rgba(79, 211, 171, 0.08); border-color: rgba(79, 211, 171, 0.3);">
						<div class="flex items-center justify-between">
							<span>Fondo Limpio · Franja Cinemascope</span>
							<span class="text-sm text-white/50">1o</span>
						</div>
					</a>
					<a href="/screens/mint/ended" class="overlay-link" style="background: rgba(79, 211, 171, 0.08); border-color: rgba(79, 211, 171, 0.3);">
						<div class="flex items-center justify-between">
							<span>El Stream Terminó</span>
							<span class="text-sm text-white/50">1g</span>
						</div>
					</a>
					<a href="/screens/mint/justchatting" class="overlay-link" style="background: rgba(79, 211, 171, 0.08); border-color: rgba(79, 211, 171, 0.3);">
						<div class="flex items-center justify-between">
							<span>Solo Charla</span>
							<span class="text-sm text-white/50">1h</span>
						</div>
					</a>
					<a href="/screens/mint/brb" class="overlay-link" style="background: rgba(79, 211, 171, 0.08); border-color: rgba(79, 211, 171, 0.3);">
						<div class="flex items-center justify-between">
							<span>Ya Vuelvo</span>
							<span class="text-sm text-white/50">BRB</span>
						</div>
					</a>
					<a href="/screens/mint/components/alert-live" class="overlay-link" style="background: rgba(79, 211, 171, 0.08); border-color: rgba(79, 211, 171, 0.3);">
						<div class="flex items-center justify-between">
							<span>Alertas En Vivo</span>
							<span class="text-sm text-white/50">fuente real para OBS</span>
						</div>
					</a>
					<a href="/stream-screens-mint" class="overlay-link" style="background: rgba(79, 211, 171, 0.08); border-color: rgba(79, 211, 171, 0.3);">
						<div class="flex items-center justify-between">
							<span>Galería Completa + Componentes Sueltos</span>
							<span class="text-sm text-white/50">chat, cámara, alertas, marcador, paisaje…</span>
						</div>
					</a>
				</div>

				<h3 class="text-white/80 text-lg font-light mb-3 text-center">🧪 Probar sin estar en vivo</h3>
				<div class="flex flex-col gap-3 mb-4">
					<a href="/screens/mint/components/chat-tester" class="overlay-link" style="background: rgba(79, 211, 171, 0.08); border-color: rgba(79, 211, 171, 0.3);">
						<div class="flex items-center justify-between">
							<span>Probar Chat</span>
							<span class="text-sm text-white/50">botones para simular mensajes</span>
						</div>
					</a>
					<a href="/screens/mint/components/alert-tester" class="overlay-link" style="background: rgba(79, 211, 171, 0.08); border-color: rgba(79, 211, 171, 0.3);">
						<div class="flex items-center justify-between">
							<span>Probar Alertas / Suscripciones</span>
							<span class="text-sm text-white/50">botones para simular seguidor, sub, bits, raid</span>
						</div>
					</a>
				</div>
			</div>

			<div class="mt-8 pt-8 border-t border-white/20">
				<h2 class="text-white text-2xl font-light mb-4 text-center">Twitch Integration</h2>
				<div class="flex flex-col gap-4 mb-8">
					<a href="/twitch-setup" class="overlay-link" style="background: rgba(145, 71, 255, 0.1); border-color: rgba(145, 71, 255, 0.3);">
						<div class="flex items-center justify-between">
							<span>⚙️ Twitch Setup</span>
							<span class="text-sm text-white/50">Configure credentials</span>
						</div>
					</a>
					<a href="/chat/twitch-live" class="overlay-link" style="background: rgba(145, 71, 255, 0.1); border-color: rgba(145, 71, 255, 0.3);">
						<div class="flex items-center justify-between">
							<span>💬 Twitch Chat Live</span>
							<span class="text-sm text-white/50">Real-time chat</span>
						</div>
					</a>
				</div>

				<p class="text-white/40 text-sm text-center">
					Elementos espaciales • Versiones EN/ES • Animaciones fluidas
				</p>
			</div>
		</div>
	</body>
</html>
